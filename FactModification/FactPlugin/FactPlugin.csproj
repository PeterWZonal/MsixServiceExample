<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Emits FactPlugin.deps.json so AssemblyDependencyResolver can resolve any plugin-private dependencies -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <!-- The contract assembly is provided by the host (main package); don't copy it next to the plugin -->
    <ProjectReference Include="..\..\BackgroundService\BackgroundService.Contracts\BackgroundService.Contracts.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>

</Project>
